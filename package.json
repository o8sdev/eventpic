{
  "name": "snapmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "test:billing": "node scripts/test-billing-db.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:access": "node scripts/test-account-access.mjs",
    "admin:bootstrap": "node scripts/create-admin-bootstrap.mjs",
    "test:events": "tsx --test tests/events.test.ts",
    "test:site": "tsx --test tests/site-content.test.ts",
    "check:setup": "node scripts/check-setup.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "worker:dev": "npm run dev --prefix worker",
    "worker:build": "npm run build --prefix worker",
    "worker:start": "npm start --prefix worker",
    "worker:check": "npm run check --prefix worker",
    "test:worker": "npm test --prefix worker"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.100.0",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
