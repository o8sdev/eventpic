NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
# Server/worker only. Phase 3 worker requires this; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Worker: use eu-central-1. In production prefer an IAM role over static keys.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary AWS credentials.
AWS_SESSION_TOKEN=
WORKER_CONCURRENCY=2
WORKER_POLL_MS=5000
IP_HASH_SECRET=
# Local provisioning helper only. Never grants access from signup metadata.
ADMIN_BOOTSTRAP_EMAIL=
